# =============================================================================
#  NGINX SITE TEMPLATE
# =============================================================================
#  Rendered by the nginx:alpine entrypoint (envsubst over
#  /etc/nginx/templates/*.template) into /etc/nginx/conf.d/default.conf at
#  container start.
#
#  NGINX_ENVSUBST_FILTER is set in the Dockerfile so ONLY ${CLIENT_INTERNAL_PORT}
#  is substituted — nginx's own runtime variables ($uri, $host, ...) must survive
#  the pass untouched.
#
#  The listen port is container-internal and identical in every instance;
#  instances are separated by host port mapping (CLIENT_HOST_PORT), not here.
# =============================================================================

server {
    listen ${CLIENT_INTERNAL_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # The per-instance server endpoint is rendered into this file at container
    # start (see docker-entrypoint.d/20-render-config-json.sh). It MUST never be
    # cached: a stale copy would point a redeployed instance at the previous
    # instance's WebSocket port.
    location = /config.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
    }

    # Hashed Vite bundle assets are content-addressed and safe to cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html is the entry point that references the hashed bundles — caching
    # it would pin clients to a stale bundle graph after a redeploy.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
    }

    # The client connects to the game server DIRECTLY (its own published host
    # port), so no WebSocket proxy is defined here. Adding one would route
    # player traffic through nginx and break the per-instance port isolation
    # model, since every instance's client would then share one entry path.
}
