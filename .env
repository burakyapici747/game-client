# Local development values. See .env.example for the full schema.
#
# This file previously carried a production IP (VITE_SERVER_URL=35.242.203.43),
# which baked that host into every build. Under the multi-instance model the
# endpoint is injected at CONTAINER START instead, so the build-time fallback
# is left empty and these values apply to `npm run dev` only.

CLIENT_DEV_PORT=3000

VITE_SERVER_URL=35.242.203.43
VITE_SERVER_PORT=8080
VITE_SERVER_SCHEME=ws
VITE_SERVER_PATH=/ws

VITE_SERVER_URL=
