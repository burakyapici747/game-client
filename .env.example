# =============================================================================
#  GAME CLIENT — LOCAL DEV ENVIRONMENT
# =============================================================================
#  Copy to ".env" for local development. ".env" is gitignored.
#
#  ── THIS FILE IS FOR `npm run dev` ONLY ────────────────────────────────────
#  In Docker, NONE of these matter. The production bundle is instance-agnostic
#  and reads its endpoint at runtime from /config.json, which the container's
#  entrypoint renders from the environment supplied by docker-compose.yml
#  (see ../game-server/.env.example for the deployment schema).
#
#  Setting VITE_SERVER_* for a production BUILD bakes a host into the image and
#  makes it instance-specific — the opposite of what the multi-instance model
#  needs. Leave them empty when building for deployment.
# =============================================================================


# -----------------------------------------------------------------------------
# Vite dev server
# -----------------------------------------------------------------------------
# Port this dev server binds. Leave EMPTY to let Vite choose its own default.
# When set, strictPort is enabled so the dev server fails instead of silently
# sliding to the next free port — which would leave you looking at a different
# instance than the one you meant to start.
# Mirror the deployment formula if you want parity: 3000 + 2N.
CLIENT_DEV_PORT=3000


# -----------------------------------------------------------------------------
# Game server endpoint (build-time fallback, exposed to the bundle)
# -----------------------------------------------------------------------------
# Consulted ONLY when /config.json is absent or unresolvable. Any part left
# empty is derived from the page origin at runtime.
#
# VITE_SERVER_PORT is the part that CANNOT be derived: the page is served on
# CLIENT_DEV_PORT while the game server listens on its own port, so origin
# derivation would produce the wrong one. Set it to the server's port —
# 8080 + N under the deployment formula.
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=8080
VITE_SERVER_SCHEME=ws
VITE_SERVER_PATH=/ws

# Legacy name, kept for compatibility with the existing Docker build ARG. It
# carries a HOST (not a full URL) and is treated as an alias for
# VITE_SERVER_HOST. Prefer VITE_SERVER_HOST in new setups.
VITE_SERVER_URL=
