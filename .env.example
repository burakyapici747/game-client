# Tracked schema for the local .env. Copy and fill in:
#
#   cp .env.example .env
#
# The production endpoint is NOT set here. Deployed and native builds read
# public/config.json at runtime, and fall back to the compiled-in default
# wss://seanakes.io/ws. These values only affect `npm run dev`, where the
# client talks to a game server running on your own machine.
# Full resolution order: src/network/endpoint.js

# Vite dev server port.
CLIENT_DEV_PORT=3000

# Game server the dev build dials. Host only — no scheme, no path.
# Empty means 127.0.0.1.
VITE_SERVER_URL=

# ws for a plain local server, wss when pointing dev at a TLS-terminated host.
VITE_SERVER_SCHEME=ws
VITE_SERVER_PORT=8080
VITE_SERVER_PATH=/ws

# Overrides the compiled-in production endpoint at build time. Leave unset to
# use wss://seanakes.io/ws.
# VITE_WS_URL=wss://seanakes.io/ws

# ── Java proxy (HTTP /api/**) ────────────────────────────────────────────────
# Resolution order lives in src/network/endpoint.js -> resolveApiBaseUrl().
#
# Leave BOTH unset for the normal deployment: the proxy sits behind the same
# nginx as the page, so the client calls /api/... on its own origin and no CORS
# preflight is involved at all.
#
# Port of the Java proxy during `npm run dev`. Falls back to VITE_SERVER_PORT.
# VITE_API_PORT=8080
#
# Full override (scheme://host[:port], no trailing slash). Use only when the
# proxy really is on another origin. Setting this makes every protected call
# cross-origin, so the proxy's WebMvcConfig must allow this page's origin and
# list 'Authorization' in allowedHeaders.
# VITE_API_BASE_URL=http://127.0.0.1:8080
